---
/*
  One inline SVG sprite, rendered server-side once per page. Icons are
  referenced with <svg class="icon"><use href="#i-name" /></svg>.
  No external requests, no <img>, no photography — line marks only.
  Every icon is decorative: each one sits beside text that carries the
  same meaning, so all uses are aria-hidden.
*/
---

<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <g id="stroke-defaults" />
  </defs>

  <!-- brand mark: a bowl with a rising chevron -->
  <symbol id="i-logo" viewBox="0 0 24 24">
    <path d="M3 10h18a9 9 0 0 1-18 0z" fill="currentColor" stroke="none" />
    <path d="M7.5 6.5 12 2.5l4.5 4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </symbol>

  <!-- meal formats -->
  <symbol id="i-bowl" viewBox="0 0 24 24">
    <path d="M2.5 10.5h19a9.5 9.5 0 0 1-19 0z" />
    <path d="M8 7.5c.6-1.2 1.9-2 4-2s3.4.8 4 2" />
  </symbol>
  <symbol id="i-burrito" viewBox="0 0 24 24">
    <path d="M6.2 17.8 17.8 6.2a3.6 3.6 0 0 1 0 5.1l-6.5 6.5a3.6 3.6 0 0 1-5.1 0z" />
    <path d="M17.8 6.2a3.6 3.6 0 0 0-5.1 0" />
    <path d="M9 15l1.8-1.8M12 12l1.8-1.8" />
  </symbol>
  <symbol id="i-salad" viewBox="0 0 24 24">
    <path d="M2.5 12.5h19a9.5 9.5 0 0 1-19 0z" />
    <path d="M8.5 9.5c-1.5-2 .5-4.5 2.5-4 .3-2 3-2.5 4 0 2-.5 3.3 1.7 2 3.4" />
  </symbol>
  <symbol id="i-tacos" viewBox="0 0 24 24">
    <path d="M3 17.5a9 9 0 0 1 18 0z" />
    <path d="M7.5 17.5c0-2.4.9-4.6 2.3-6M13 11.2c1.5 1.5 2.5 3.7 2.5 6.3" />
  </symbol>
  <symbol id="i-quesadilla" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 3v18M3 12h18" />
  </symbol>
  <symbol id="i-kids" viewBox="0 0 24 24">
    <path d="M5 13h14a7 7 0 0 1-14 0z" />
    <path d="M12 3.5l1.1 2.3 2.5.3-1.8 1.8.4 2.5-2.2-1.2-2.2 1.2.4-2.5L8.4 6.1l2.5-.3z" />
  </symbol>

  <!-- ingredient categories -->
  <symbol id="i-protein" viewBox="0 0 24 24">
    <path d="M6.5 15.5a5.5 5.5 0 0 1 3-9.4c2.6-.5 5 .6 6.6 2.6 1.5 1.9 2 4.4 1 6.2-1.1 2-3.7 2.8-6.4 2.4-2-.3-3.6-1-4.2-1.8z" />
    <path d="M10 10.5c1.2-.3 2.4 0 3.2.9M9.5 13.6c1-.2 2 0 2.7.7" />
  </symbol>
  <symbol id="i-rice" viewBox="0 0 24 24">
    <ellipse cx="8" cy="8.5" rx="2.1" ry="1.3" transform="rotate(-28 8 8.5)" />
    <ellipse cx="15.4" cy="9.6" rx="2.1" ry="1.3" transform="rotate(20 15.4 9.6)" />
    <ellipse cx="11.6" cy="13.4" rx="2.1" ry="1.3" transform="rotate(-12 11.6 13.4)" />
    <ellipse cx="7.3" cy="16.4" rx="2.1" ry="1.3" transform="rotate(16 7.3 16.4)" />
    <ellipse cx="16" cy="16" rx="2.1" ry="1.3" transform="rotate(-22 16 16)" />
  </symbol>
  <symbol id="i-beans" viewBox="0 0 24 24">
    <path d="M9.6 5.6c2.4 0 4 1.7 4 3.6s-1.6 3-3.6 3S6 10.7 6 8.6 7.4 5.6 9.6 5.6z" />
    <path d="M15 12.2c2.3 0 3.8 1.6 3.8 3.5S17.3 19 15.4 19s-3.6-1.3-3.6-3.3 1.3-3.5 3.2-3.5z" />
  </symbol>
  <symbol id="i-salsa" viewBox="0 0 24 24">
    <path d="M15.5 7.5c1.8 1.8 2 5-.2 7.6-2.1 2.5-5.3 3.6-7.4 2.6-1.4-.7-1.8-2.3-1-3.6.9-1.4 2.7-1.6 3.6-.4" />
    <path d="M15.5 7.5c-.6-1.6.2-3 1.6-3.5M15.5 7.5c1.3-.5 2.6-.2 3.4.7" />
  </symbol>
  <symbol id="i-toppings" viewBox="0 0 24 24">
    <path d="M12 4.5c3.6 0 6.5 3.3 6.5 7.3S15.6 19.5 12 19.5s-6.5-3.7-6.5-7.7S8.4 4.5 12 4.5z" />
    <ellipse cx="12" cy="13" rx="2.6" ry="3.1" />
  </symbol>
  <symbol id="i-sides" viewBox="0 0 24 24">
    <path d="M4.5 18.5 11 5.5l6.5 13z" />
    <path d="M8 15.5h6.5" />
  </symbol>

  <!-- nutrition metrics -->
  <symbol id="i-cal" viewBox="0 0 24 24">
    <path d="M12 3.5c3 3.4 5.5 6 5.5 9.4A5.5 5.5 0 0 1 12 18.4a5.5 5.5 0 0 1-5.5-5.5C6.5 9.5 9 6.9 12 3.5z" />
    <path d="M12 15.5a2.4 2.4 0 0 0 2.4-2.4c0-1.4-1.1-2.3-2.4-3.8-1.3 1.5-2.4 2.4-2.4 3.8A2.4 2.4 0 0 0 12 15.5z" />
  </symbol>
  <symbol id="i-p" viewBox="0 0 24 24">
    <path d="M3.5 10v4M6.5 8v8M17.5 8v8M20.5 10v4M6.5 12h11" />
  </symbol>
  <symbol id="i-c" viewBox="0 0 24 24">
    <path d="M12 20V8" />
    <path d="M12 12c-2.6 0-4.4-1.6-4.4-4.2 2.6 0 4.4 1.6 4.4 4.2zM12 12c2.6 0 4.4-1.6 4.4-4.2-2.6 0-4.4 1.6-4.4 4.2z" />
    <path d="M12 16.5c-2.2 0-3.8-1.4-3.8-3.6 2.2 0 3.8 1.4 3.8 3.6zM12 16.5c2.2 0 3.8-1.4 3.8-3.6-2.2 0-3.8 1.4-3.8 3.6z" />
  </symbol>
  <symbol id="i-f" viewBox="0 0 24 24">
    <path d="M12 3.8c3.3 4 5.7 6.7 5.7 9.6A5.7 5.7 0 0 1 12 19.1a5.7 5.7 0 0 1-5.7-5.7c0-2.9 2.4-5.6 5.7-9.6z" />
  </symbol>
  <symbol id="i-fib" viewBox="0 0 24 24">
    <path d="M12 20V9" />
    <path d="M12 12.5c-3.6 0-6-2.4-6-6 3.6 0 6 2.4 6 6zM12 9.5c0-3.2 2.1-5.4 5.3-5.4 0 3.2-2.1 5.4-5.3 5.4z" />
  </symbol>
  <symbol id="i-na" viewBox="0 0 24 24">
    <path d="M8 9h8l1 10.5H7z" />
    <path d="M9.2 9V6.4a2.8 2.8 0 0 1 5.6 0V9" />
    <path d="M11 12.5h.01M13 15h.01M11 16.8h.01" stroke-linecap="round" stroke-width="2" />
  </symbol>
  <symbol id="i-sug" viewBox="0 0 24 24">
    <path d="M4.5 8.6 12 5l7.5 3.6-7.5 3.6z" />
    <path d="M4.5 8.6V15l7.5 3.6V12.2M19.5 8.6V15L12 18.6" />
  </symbol>
  <symbol id="i-sat" viewBox="0 0 24 24">
    <path d="M12 3.8c3.3 4 5.7 6.7 5.7 9.6A5.7 5.7 0 0 1 12 19.1a5.7 5.7 0 0 1-5.7-5.7c0-2.9 2.4-5.6 5.7-9.6z" fill="currentColor" stroke="none" opacity="0.28" />
    <path d="M12 3.8c3.3 4 5.7 6.7 5.7 9.6A5.7 5.7 0 0 1 12 19.1a5.7 5.7 0 0 1-5.7-5.7c0-2.9 2.4-5.6 5.7-9.6z" />
  </symbol>

  <!-- direction / semantics -->
  <symbol id="i-up" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" /></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6" /></symbol>
  <symbol id="i-flat" viewBox="0 0 24 24"><path d="M4 12h16M14 7l5 5-5 5" /></symbol>

  <!-- ui + navigation -->
  <symbol id="i-copy" viewBox="0 0 24 24">
    <rect x="8.5" y="8.5" width="11" height="11" rx="2" />
    <path d="M15.5 8.5v-2a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" />
  </symbol>
  <symbol id="i-share" viewBox="0 0 24 24">
    <circle cx="17.5" cy="6" r="2.6" /><circle cx="6.5" cy="12" r="2.6" /><circle cx="17.5" cy="18" r="2.6" />
    <path d="M8.8 10.8 15.2 7.2M8.8 13.2l6.4 3.6" />
  </symbol>
  <symbol id="i-shield" viewBox="0 0 24 24">
    <path d="M12 3.2 19 6v5.6c0 4-2.8 7.3-7 9.2-4.2-1.9-7-5.2-7-9.2V6z" />
    <path d="m9 12 2.2 2.2L15.4 10" />
  </symbol>
  <symbol id="i-grid" viewBox="0 0 24 24">
    <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
    <path d="M3.5 9.5h17M3.5 14.5h17M9.5 9.5v10" />
  </symbol>
  <symbol id="i-gauge" viewBox="0 0 24 24">
    <path d="M4 16a8 8 0 1 1 16 0" />
    <path d="M12 16l4-4.5" />
    <path d="M4 16h2M18 16h2" stroke-linecap="round" />
  </symbol>
  <symbol id="i-help" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8.5" />
    <path d="M9.8 9.6a2.3 2.3 0 0 1 4.4.8c0 1.6-2.2 1.9-2.2 3.3" />
    <path d="M12 17.2h.01" stroke-linecap="round" stroke-width="2" />
  </symbol>
  <symbol id="i-leaf" viewBox="0 0 24 24">
    <path d="M19 5c0 7.2-3.6 11.5-9 11.5-2.6 0-4.5-1.6-4.5-4C5.5 8.4 10.6 5 19 5z" />
    <path d="M5.5 19c1.8-4.2 4.4-7 8-8.6" />
  </symbol>
  <symbol id="i-list" viewBox="0 0 24 24">
    <path d="M9 6.5h11M9 12h11M9 17.5h11" stroke-linecap="round" />
    <path d="M4.5 6.5h.01M4.5 12h.01M4.5 17.5h.01" stroke-linecap="round" stroke-width="2.4" />
  </symbol>
</svg>

<style is:global>
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  /*
    Paint must be declared on the <use> host, not on <symbol>. Rules matching
    the symbol do not cascade into the shadow tree the <use> clones, so paths
    would fall back to the default fill (solid black) and render as filled
    blobs. These properties are inherited, so they do reach the clone.
    Symbols that want a solid fill set it as a presentation attribute, which
    beats the inherited value.
  */
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
    display: inline-block;
    vertical-align: -0.14em;
    color: inherit;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
