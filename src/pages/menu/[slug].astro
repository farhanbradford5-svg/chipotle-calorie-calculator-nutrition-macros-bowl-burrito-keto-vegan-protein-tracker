---
import Base from '../../layouts/Base.astro';
import NutritionTable from '../../components/NutritionTable.astro';
import { ITEMS, itemH1, siblingsFor } from '../../content/items.js';
import { anchor } from '../../content/anchors.js';
import { KEYS } from '../../data/builds.js';

export function getStaticPaths() {
  return ITEMS.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const path = `/menu/${item.slug}`;
const h1 = itemH1(item);
const t = item.totals;
const pid = `item:${item.slug}`;
const siblings = siblingsFor(item.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Chipotle Nutrition Calculator', item: 'https://chipotlemacros.com/' },
      { '@type': 'ListItem', position: 2, name: 'Menu nutrition', item: 'https://chipotlemacros.com/menu' },
      { '@type': 'ListItem', position: 3, name: item.name, item: `https://chipotlemacros.com${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: item.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<Base title={item.title} description={item.description} path={path} schema={schema}>
  <div class="wrap page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Calculator</a> <span aria-hidden="true">›</span>
      <a href="/menu">Menu nutrition</a> <span aria-hidden="true">›</span>
      <span>{item.name}</span>
    </nav>

    <h1>{h1}</h1>
    <p class="lede" set:html={item.opening} />

    <section aria-labelledby="macros-h">
      <h2 id="macros-h">Full nutrition for {item.name.toLowerCase()}</h2>
      {item.buildLabel && (
        <p class="build-note">
          Figures are for a {item.name.toLowerCase()} with {item.buildLabel}. Change any part of it
          in <a href="/">{anchor('/', pid, 7)}</a> to see how the totals move.
        </p>
      )}
      <NutritionTable
        rows={[[item.name, t]]}
        serving={item.kind === 'ingredient' ? 'Standard serving' : 'Build'}
        caption="Estimates from Chipotle's published nutrition data. Hand-scooped portions vary by location."
      />
    </section>

    <section aria-labelledby="why-h">
      <h2 id="why-h">{item.why.heading}</h2>
      <p set:html={item.why.body} />
    </section>

    <section aria-labelledby="cmp-h">
      <h2 id="cmp-h">{item.comparison.heading}</h2>
      <p set:html={item.comparison.body} />
      <NutritionTable rows={item.comparison.rows} serving="Side by side" />
    </section>

    <section aria-labelledby="faq-h">
      <h2 id="faq-h">Questions about {item.name.toLowerCase()}</h2>
      <div class="qa-list">
        {item.faq.map((f) => (
          <article class="qa">
            <h3>
              <svg class="icon qa-icon" aria-hidden="true"><use href="#i-help" /></svg>
              {f.q}
            </h3>
            <p set:html={f.a} />
          </article>
        ))}
      </div>
    </section>

    <section class="related" aria-labelledby="rel-h">
      <h2 id="rel-h">Nutrition for related items</h2>
      <ul class="rel-list">
        {siblings.map((sib) => (
          <li>
            <a href={`/menu/${sib.slug}`}>{sib.name} calories</a> — {sib.totals.cal} cal, {sib.totals.p} g protein,
            {' '}{sib.totals.na.toLocaleString('en-US')} mg sodium
          </li>
        ))}
      </ul>
    </section>

    <p class="back">
      Every figure here follows <a href="/methodology">{anchor('/methodology', pid)}</a>. Browse
      <a href="/menu">{anchor('/menu', pid)}</a>, or
      <a href="/">{anchor('/', pid)}</a>.
    </p>
  </div>
</Base>

<style>
  .page { padding: 1.6rem 0 1rem; }
  .page h1 { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.1rem); margin-bottom: 0.7rem; }
  .page h2 { margin: 1.9rem 0 0.5rem; }
  .page p { max-width: 74ch; color: var(--ink-2); }
  .lede { font-size: 1.05rem; color: var(--ink) !important; }
  .build-note { font-size: 0.88rem; }
  .crumb { font-size: 0.83rem; color: var(--ink-3); margin-bottom: 0.7rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .qa-list { display: grid; gap: 0.6rem; max-width: 80ch; }
  .qa { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.8rem 1rem; }
  .qa h3 { display: flex; gap: 0.45rem; align-items: flex-start; font-size: 1rem; margin-bottom: 0.35rem; }
  .qa-icon { font-size: 1.1rem; color: var(--accent); margin-top: 0.08em; }
  .qa p { font-size: 0.9rem; margin: 0; }
  .related { margin-top: 1.9rem; }
  .rel-list { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.4rem; max-width: 74ch; font-size: 0.92rem; color: var(--ink-2); }
  .back { margin-top: 2rem; font-size: 0.92rem; border-top: 1px solid var(--line); padding-top: 1rem; }
</style>
